<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee 
              http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
         version="2.5"
         xmlns="http://java.sun.com/xml/ns/javaee">

    <servlet>
        <servlet-name>TelephonyService</servlet-name>
        <servlet-class>com.telephony.server.TelephonyServiceImpl</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>TelephonyService</servlet-name>
        <url-pattern>/telephony/rpc/*</url-pattern>
    </servlet-mapping>
    
  <welcome-file-list>
    <welcome-file>Telephony.html</welcome-file>
  </welcome-file-list>

</web-app>
